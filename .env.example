# Copy to a file outside the repo (chmod 600) and source it, or point a systemd
# EnvironmentFile at it. Every value below is a placeholder.

# --- cognee spine database (Postgres + pgvector) -------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cognee_prod
DB_USERNAME=cognee
DB_PASSWORD=change-me
ENABLE_BACKEND_ACCESS_CONTROL=True   # per-dataset stores; False ignores datasets=[...]

# --- incumbent store / audit log (the recall floor) ----------------------------
LIFEOS_PGHOST=localhost
LIFEOS_PGPORT=5432
LIFEOS_PGUSER=lifeos
LIFEOS_DB=lifeos
LIFEOS_PGPASSWORD=change-me

# --- embeddings (local ollama, nomic-embed-text 768d) --------------------------
OLLAMA_EMBED_HOST=http://localhost:11434
OLLAMA_EMBED_ENDPOINT=http://localhost:11434/api/embed
EMBEDDING_ENDPOINT=http://localhost:11434/api/embed
MIMIR_EMBED_TIMEOUT=180
NOMIC_EMBED_CONCURRENCY=4
NOMIC_EMBED_TIMEOUT=180
NOMIC_EMBED_RETRIES=3

# --- LLM used by cognify (never at read time) ----------------------------------
MIMIR_LLM_BACKEND=claude-shim        # claude-shim | openrouter
CLAUDE_SHIM_ENDPOINT=http://127.0.0.1:8088/v1
OPENROUTER_API_KEY=sk-or-placeholder
GEMINI_API_KEY=placeholder
COGNEE_LLM_MODEL=openrouter/google/gemini-2.5-flash-lite
MIMIR_WORK_PROVIDER_APPROVED=false   # work content is cognified only on an approved provider
BACKFILL_MAX_USD=30

# --- estate classifier ---------------------------------------------------------
MIMIR_ESTATES_FILE=jobs/memory-migration/estates.json   # defaults to estates.example.json
# MIMIR_CLIENT_TERMS=acme health,ledgerly               # overrides client_terms in that file
ESTATE_WORK_WEAK=false

# --- memory API: one key per registered ingress (MIMIR_KEY_<INGRESS>) ----------
# An ingress with no key configured cannot authenticate.
MIMIR_KEY_CLI=placeholder
MIMIR_KEY_CLAUDE_CODE=placeholder
MIMIR_KEY_WORK_CLI=placeholder
MIMIR_KEY_ODIN_DM_OWNER=placeholder
MIMIR_KEY_ODIN_HERMES_WORK=placeholder
MIMIR_KEY_CRACKS_BRIEF=placeholder
MIMIR_KEY_FAB=placeholder
MIMIR_KEY_HORUS=placeholder
MIMIR_KEY_IOS=placeholder
MIMIR_KEY_IMESSAGE_PRODUCER=placeholder
MIMIR_KEY_M365_PRODUCER=placeholder
MIMIR_API=http://localhost:8410
MIMIR_API_BASE=http://localhost:8410
MIMIR_MCP_INGRESS=claude_code

# --- delivery (Telegram via the agent system's shim) ----------------------------
TELEGRAM_SHIM_URL=http://localhost:3340/send
TELEGRAM_BOT_TOKEN=000000000:placeholder
TELEGRAM_CHAT_ID=000000000           # the owner's own chat; nobody else is acted on
TELEGRAM_GROUP_ID=-100xxxxxxxxxx      # the owner-only group the work assistant replies into

# --- agent system + task list ------------------------------------------------------
ODIN_CHAT_URL=http://localhost:3345/chat
TW_API_URL=http://localhost:8250
TW_API_KEY=placeholder

# --- fab (3D print pipeline) ----------------------------------------------------
FAB_API_KEY=placeholder
MESHY_API_KEY=placeholder
THINGIVERSE_TOKEN=placeholder
